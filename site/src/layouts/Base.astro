---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/inter";
import "../styles/global.css";

import { contract } from "../lib/data";
import { collectedAt } from "../lib/format";
import { REPO_URL } from "../lib/site";
import { withBase } from "../lib/urls";

interface Props {
  /** Page title as shared: also `og:title`. */
  title: string;
  description: string;
  /** Site-relative path of this page, e.g. `/deputados/101/`. */
  path: string;
  /** Site-relative path of the share card. */
  image: string;
}

const { title, description, path, image } = Astro.props;
// Astro.site is the origin only; the base path comes from withBase (AD-012).
const url = new URL(withBase(path), Astro.site).href;
const imageUrl = new URL(withBase(image), Astro.site).href;
const { meta } = contract();
const documentTitle = path === "/" ? title : `${title} - Mandato Aberto`;

// Cloudflare Web Analytics, only when the build is given a token (plan door 5): no cookie, no identifier.
const analyticsToken = process.env.CF_ANALYTICS_TOKEN;
if (analyticsToken && !/^[A-Za-z0-9_-]+$/.test(analyticsToken)) {
  throw new Error("CF_ANALYTICS_TOKEN must hold only letters, digits, '-' and '_'");
}
const beacon = analyticsToken
  ? `<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "${analyticsToken}"}'></script>`
  : "";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mandato Aberto" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href={withBase("/")}>Mandato Aberto</a>
        <p class="collected">{collectedAt(meta.generatedAt)}</p>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Este site não apoia nem se opõe a candidaturas, partidos ou federações. Todos os dados provêm de fontes oficiais indicadas em cada página. Não recebe recursos de partidos, candidatos ou campanhas.</p>
        <p>Dados: <a href="https://dadosabertos.camara.leg.br/">Câmara dos Deputados</a> e <a href="https://dadosabertos.tse.jus.br/">TSE</a> (dados abertos). Fotos: Câmara dos Deputados.</p>
        <nav class="footer-links" aria-label="Sobre o site">
          <a href={withBase("/metodologia/")}>Metodologia e fontes</a> <a href={withBase("/quem-somos/")}>Quem somos</a> <a href={withBase("/dados-e-privacidade/")}>Dados e privacidade</a> <a href={withBase("/correcoes/")}>Correções</a> <a href={withBase("/reportar-erro/")}>Reportar erro</a> <a href={REPO_URL}>Código-fonte</a>{" "}
        </nav>
      </div>
    </footer>
    {beacon && <Fragment set:html={beacon} />}
  </body>
</html>
