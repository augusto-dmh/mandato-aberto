{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roll-call.schema.json",
  "title": "roll-calls/{id}.json",
  "description": "One roll call with individual records (ballot nominal or secret)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "house",
    "id",
    "legislature",
    "date",
    "organ",
    "description",
    "approved",
    "ballot",
    "kind",
    "kindRule",
    "propositionId",
    "tallies",
    "governmentOrientation",
    "sourceUrl",
    "openingDescription",
    "lastPresentationDescription",
    "orientations",
    "votes"
  ],
  "properties": {
    "house": {
      "type": "string",
      "enum": [
        "camara",
        "senado"
      ],
      "description": "The chamber the record belongs to; part of every key (door 3)"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]+(-[0-9]+)?$",
      "description": "Official roll-call id of the house, as a string (Câmara `2497105-11`, Senate `6923`)"
    },
    "legislature": {
      "type": "integer",
      "minimum": 57
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "organ": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "approved": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ballot": {
      "type": "string",
      "enum": [
        "nominal",
        "secret",
        "symbolic"
      ],
      "description": "Decided by the presence and content of individual vote records (door 5)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "final",
        "amendment",
        "procedural",
        "unclassified"
      ],
      "description": "Set by the first matching rule of classification-rules.json (door 6)"
    },
    "kindRule": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(camara|senado)\\.[0-9]{2}$"
    },
    "propositionId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tallies": {
      "$ref": "#/$defs/tallies"
    },
    "governmentOrientation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "yes",
        "no",
        "abstention",
        "obstruction",
        "free",
        null
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "openingDescription": {
      "type": [
        "string",
        "null"
      ],
      "description": "ultimaAberturaVotacao_descricao (door 8)"
    },
    "lastPresentationDescription": {
      "type": [
        "string",
        "null"
      ],
      "description": "ultimaApresentacaoProposicao_descricao (door 8)"
    },
    "orientations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/orientation"
      }
    },
    "votes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vote"
      }
    }
  },
  "$defs": {
    "tallies": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "yes",
        "no",
        "others"
      ],
      "properties": {
        "yes": {
          "type": "integer",
          "minimum": 0
        },
        "no": {
          "type": "integer",
          "minimum": 0
        },
        "others": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "null for a symbolic ballot and for a secret ballot with no record (door 5)"
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "official",
        "position",
        "party",
        "partyMajority"
      ],
      "properties": {
        "memberId": {
          "type": "integer",
          "minimum": 1
        },
        "official": {
          "type": "string",
          "pattern": "^(?!(?:LS|LP|LAP)$)",
          "description": "The source value verbatim, except codes the house's sensitive map generalises; LS, LP and LAP are never published (door 10, AD-018)"
        },
        "position": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "abstention",
            "obstruction",
            "presiding",
            "secret",
            "notVoting"
          ]
        },
        "party": {
          "type": "string"
        },
        "partyMajority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "yes",
            "no",
            "abstention",
            "obstruction",
            "presiding",
            "secret",
            "notVoting",
            null
          ]
        }
      },
      "description": "One member's record in one roll call (door 7)"
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bench",
        "official",
        "position"
      ],
      "properties": {
        "bench": {
          "type": "string"
        },
        "official": {
          "type": "string"
        },
        "position": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "abstention",
            "obstruction",
            "free"
          ]
        }
      }
    }
  }
}
