{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "joint-roll-call.schema.json",
  "title": "joint-roll-calls/{id}.json",
  "description": "One joint roll call with its votes, by house then name",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "actId",
    "deviceIdentifier",
    "legislature",
    "date",
    "session",
    "method",
    "question",
    "result",
    "tallies",
    "votesAvailable",
    "sourceUrl",
    "votes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{2}\\.\\d{2}\\.\\d{3}$",
      "description": "The device identifier (door 5)"
    },
    "actId": {
      "type": "string",
      "pattern": "^vet-[0-9]+-[0-9]{4}$"
    },
    "deviceIdentifier": {
      "type": "string",
      "pattern": "^\\d{2}\\.\\d{2}\\.\\d{3}$"
    },
    "legislature": {
      "type": "integer",
      "minimum": 57
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "session": {
      "type": [
        "string",
        "null"
      ],
      "description": "Session text verbatim from the device result"
    },
    "method": {
      "type": "string",
      "enum": [
        "cedula",
        "painel"
      ]
    },
    "question": {
      "type": "string",
      "const": "keepVeto",
      "description": "`yes` keeps the veto"
    },
    "result": {
      "type": "string",
      "enum": [
        "kept",
        "overridden"
      ]
    },
    "tallies": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "camara",
        "senado"
      ],
      "properties": {
        "camara": {
          "$ref": "#/$defs/tally"
        },
        "senado": {
          "$ref": "#/$defs/tally"
        }
      }
    },
    "votesAvailable": {
      "type": "boolean",
      "description": "false for a total veto: its votes are only in a PDF"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "votes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vote"
      }
    }
  },
  "$defs": {
    "tally": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yes",
        "no",
        "abstention",
        "obstruction",
        "blank",
        "presiding"
      ],
      "properties": {
        "yes": {
          "type": "integer",
          "minimum": 0
        },
        "no": {
          "type": "integer",
          "minimum": 0
        },
        "abstention": {
          "type": "integer",
          "minimum": 0
        },
        "obstruction": {
          "type": "integer",
          "minimum": 0
        },
        "blank": {
          "type": "integer",
          "minimum": 0
        },
        "presiding": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Votes of one house per position, counted from the published votes"
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "house",
        "memberId",
        "name",
        "party",
        "uf",
        "official",
        "position"
      ],
      "properties": {
        "house": {
          "type": "string",
          "enum": [
            "camara",
            "senado"
          ],
          "description": "The house the member sits in; presidencia and congresso are never house values (contract-v3 door 3)"
        },
        "memberId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Member id of that house's members.json (door 6)"
        },
        "name": {
          "type": "string"
        },
        "party": {
          "type": "string"
        },
        "uf": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "official": {
          "type": "string",
          "description": "`TipoVoto` verbatim"
        },
        "position": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "abstention",
            "obstruction",
            "blank",
            "presiding"
          ]
        }
      }
    }
  }
}
