{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acts.schema.json",
  "title": "acts.json",
  "description": "Every provisional measure, veto and Executive bill of the known terms",
  "type": "array",
  "items": {
    "$ref": "#/$defs/act"
  },
  "$defs": {
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "type",
        "number",
        "year",
        "issuedAt",
        "termId",
        "summary",
        "status",
        "officialStatus",
        "statusRule",
        "statusAt",
        "law",
        "stages",
        "relatedActId",
        "vetoedMatter",
        "vetoScope",
        "devices",
        "sourceUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(mpv|vet|pl|plp|pec)-[0-9]+-[0-9]{4}$",
          "description": "`<type>-<number>-<year>` (door 2)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "provisionalMeasure",
            "veto",
            "bill"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "MPV",
            "VET",
            "PL",
            "PLP",
            "PEC"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1988
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "termId": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}$"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "approvedAmended",
            "rejected",
            "lapsed",
            "revoked",
            "returned",
            "decided",
            "inProgress",
            "law",
            "vetoedTotally",
            "withdrawn",
            "archived"
          ],
          "description": "Lifecycle value set by status-rules.json; the enum of each kind is in door 4"
        },
        "officialStatus": {
          "type": [
            "string",
            "null"
          ],
          "description": "The source's code or text verbatim"
        },
        "statusRule": {
          "type": "string",
          "pattern": "^(mpv|veto|bill)\\.\\d{2}$"
        },
        "statusAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "law": {
          "type": [
            "string",
            "null"
          ],
          "description": "The source's law name verbatim (`normaGerada`)"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "relatedActId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(mpv|vet|pl|plp|pec)-[0-9]+-[0-9]{4}$"
        },
        "vetoedMatter": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "number",
            "year"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "year": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "vetoScope": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "total",
            "partial",
            null
          ]
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          }
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "description": "One official decision of the Presidência in scope (door 2)"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "house",
        "propositionId"
      ],
      "properties": {
        "house": {
          "type": "string",
          "enum": [
            "camara",
            "senado"
          ],
          "description": "The house the member sits in; presidencia and congresso are never house values (contract-v3 door 3)"
        },
        "propositionId": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The act's proposition id in one house, the key of that house's roll-calls[].propositionId"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "description",
        "text",
        "reason",
        "status",
        "officialStatus",
        "statusRule",
        "jointRollCallId"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "description": "Official device identifier, `49.23.001`"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Vetoed text, verbatim (`Conteudo`)"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reason for the veto, verbatim (`RazaoVeto`)"
        },
        "status": {
          "type": "string",
          "enum": [
            "kept",
            "overridden",
            "prejudged",
            "pending"
          ]
        },
        "officialStatus": {
          "type": "string",
          "description": "`Situacao` verbatim"
        },
        "statusRule": {
          "type": "string",
          "pattern": "^device\\.\\d{2}$"
        },
        "jointRollCallId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The id of the joint roll call on this device, or null"
        }
      },
      "description": "One vetoed device of a veto"
    }
  }
}
